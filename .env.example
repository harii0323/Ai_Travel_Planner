# ==============================================================
# VISTA AI Travel Planner - Enterprise Environment Template
# --------------------------------------------------------------
# DO NOT commit real secrets or production credentials to Git.
# Copy this file to .env and configure your environment-specific values.
# ==============================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development
REQUEST_BODY_LIMIT=2mb
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1

# PostgreSQL Database Configuration
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:your_db_password_here@localhost:5432/ai_travel_planner
POSTGRES_POOL_SIZE=10
POSTGRES_TIMEOUT=30000
POSTGRES_SSL=false
# Optional path or PEM string for verifying DB CA certificate in production
# POSTGRES_CA_CERT=

# Authentication & Session Security (Minimum 32 random characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d

# Google Maps API Configuration (Server-Side Key)
# Scope restrictions: Distance Matrix API, Routes API, Places API, Geocoding API
# Network restrictions: Restrict to server static egress IPs
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here

# Partner Fleet Integration (A6 Cars)
CAR_RENTAL_API_URL=https://a6cars-backend.example.com
CAR_RENTAL_FRONTEND_URL=https://a6cars-frontend.example.com
CAR_RENTAL_API_KEY=your_car_rental_api_key_here
CAR_RENTAL_SERVICE_EMAIL=your_service_email@example.com
CAR_RENTAL_SERVICE_PASSWORD=your_service_password_here
CAR_RENTAL_TIMEOUT_MS=3000

# Client-Side Configuration (Frontend Browser Keys)
# Scope restrictions: Maps JavaScript API / Maps Embed API ONLY
# HTTP Referrer restrictions: Restrict to https://yourdomain.com/*
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_GOOGLE_MAPS_EMBED_KEY=your_google_maps_restricted_browser_embed_key_here
